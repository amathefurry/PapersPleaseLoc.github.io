{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": [
			"node"
		]
	},
	"include": [
		"*.js"
	],
	"exclude": [
		"node_modules",
		"__tmp__",
		"dist",
		"build"
	]
}
